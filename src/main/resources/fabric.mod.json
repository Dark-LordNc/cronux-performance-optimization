  "authors": ["Dark-LordNc"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["fr.cronux.perf.CronuxPerf"]
  },
  "mixins": ["cronux.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21"
  },
  "suggests": {
    "sodium": "*",
    "lithium": "*",
    "ferritecore": "*",
    "immediatelyfast": "*",
    "entityculling": "*"
  }
}
